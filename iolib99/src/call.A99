;
;  DEFINE DXOP AND REGISTERS USED
;

	DXOP	CALL,6
	DXOP	RET,7
	DXOP	PUSH,8
	DXOP	POP,9
	DXOP	WHEX,10		;WRITE OUT A 16 BIT HEX VALUE
	DXOP	WRITE,12	;WRITE CHAR IN MSB
	DXOP	DEBUG,15
;
R0	EQU	0
R1	EQU	1
R2	EQU	2
R3	EQU	3
R4	EQU	4
R5	EQU	5
R9	EQU	9
SP	EQU	10
R11	EQU	11

LDS:	EQU	0780H	;        Long Distance Source instruction operand.
LDD:	EQU	07C0H	;        Long Distance Destination instruction operand.

;
;
;
;------call.a99:  Small-C arithmetic,logical and char and int io library
;
; Small C will call _setarg so that functions can retrieve the value
; by calling the function _argcnt().
; The call to this routine is a Branch and Link  (BL ..)
;
_argcval:	WORD	0
_setargc::
	ANDI R1,00FFH
	MOV R1,@_argcval
	RT

;  _ccargc:: is not used :: is notation for entry
_argcnt::
	MOV @_argcval,R4
	RET
	
;Fetch a single byte from the address in R4 and
; sign extend into R4
;_ccgchar:: 
;	MOVB *R4,R4
;_ccsxt::	
;	SRA	R4,8
;	RT
	
;
; IN ALL THE FOLLOWING COMPARE ROUTINES, R4 IS SET TO 1 IF THE
; CONDITION IS TRUE, OTHERWISE IT I SET TO 0 (ZERO)
;
;
;  TEST IF R3 == R4
;
_cceq::	
	MOV	R4,R1
	CLR	R4
	C	R3,R1
	JNE	$+4
	INC	R4
	RT
;
; TEST IF R3 != R4
;
_ccne::	
	MOV	R4,R1
	CLR	R4
	C	R3,R1
	JEQ	$+4
	INC	R4
	RT
;
; TEST IF R3 > R4  (SIGNED)
;
_ccgt::	
	MOV	R4,R1
	LI	R4,1
	C	R3,R1
	JGT	$+4
	CLR	R4
	RT
;
; TEST IF R3 <= R4 (SIGNED)
;
_ccle::	
	MOV	R4,R1
	CLR	R4
	C	R3,R1
	JGT	$+4
	INC	R4
	RT
;
; TEST IF R3 >= R4 (SIGNED)
;
_ccge::
	MOV	R4,R1
	CLR	R4
	C	R1,R3
	JGT	$+4
	INC	R4
	RT
;
; TEST IF R3 < R4 (SIGNED)
;
_cclt::	
	MOV	R4,R1
	LI	R4,1
	C	R3,R1
	JLT	$+4
	CLR	R4
	RT	
;
; TEST IF R3 >= R4 (UNSIGNED)
;
_ccuge::	
	MOV	R4,R1
	CLR	R4
	C	R3,R1
	JL	$+4
	INC	R4
	RT
;
; TEST IF R3 < R4 (UNSIGNED)
;
_ccult::
	MOV	R4,R1
	LI	R4,1
	C	R3,R1
	JL	$+4
	CLR	R4
	RT 
;
; TEST IF R3 > R4 (UNSIGNED)
;
;
_ccugt::
	MOV	R4,R1
	LI	R4,1
	C	R3,R1
	JH	$+4
	CLR	R4
	RT
;
; TEST IF R3 <= R4 (UNSIGNED)
;
_ccule::
	MOV	R4,R1
	CLR	R4
	C	R3,R1
	JH	$+4			
	INC	R4
	RT
;
; SHIFT R3 ARITHMETICALLY RIGHT BY R4 AND RETURN IN R4
;
_ccasr::
    MOV R4,R0
    JNE _ccasr1
    MOV R3,R4
    RT

_ccasr1:
    MOV R3,R1
    SRA R1,R0
    MOV R1,R4
    RT
; SHIFT R3 ARITHMETICALLY LEFT BY R4 AND RETURN IN R4
;
;
; DIVIDE R3 BY R4, UNSIGNED, QUOTIENT IN R4 AND REMAINDER IN R3
;
; The 9900's DIV is already unsigned - a 32-bit dividend in a register
; pair over a 16-bit divisor - so this is the SHORT one.  _ccdiv above
; only exists to fake a SIGNED divide on top of it, which is why it
; carries all the negating.
;
; Without this, "unsigned x; x / 10" went through _ccdiv and was wrong
; for anything above 32767 - which is why library code had to halve and
; mask before dividing.  The compiler now picks this whenever either
; operand is unsigned, exactly as it picks _ccult over _cclt.
;
; DIV Rs,Rd divides the PAIR Rd:Rd+1 by Rs, leaving the quotient in Rd
; and the remainder in Rd+1.  The pair here is R1:R2.
;
; A zero divisor would leave DIV unexecuted with the overflow bit set,
; so it is caught first and returns zero rather than silently leaving
; the registers untouched.  _ccdiv does not do this; it could.
;
_ccudiv::
	MOV	R4,R4			; divisor zero?
	JEQ	_ccudivz
	CLR	R1			; R1:R2 is the 32-bit dividend
	MOV	R3,R2
	DIV	R4,R1			; R1 = quotient, R2 = remainder
	MOV	R2,R3			; remainder in the secondary
	MOV	R1,R4			; quotient in the primary
	RT
_ccudivz:
	CLR	R3
	CLR	R4
	RT
;
; SHIFT R3 LOGICALLY RIGHT BY R4 AND RETURN IN R4
;
; SRL sits beside SRA in the instruction set; only the arithmetic
; helper was ever written, so "unsigned x; x >> 4" dragged the sign bit
; down.  Same shape as _ccasr, one instruction different.
;
; A shift count of zero means "use R0" on this architecture, which is
; not what C means, so it is handled separately - exactly as _ccasr
; does.
;
_ccusr::
	MOV	R4,R0
	JNE	_ccusr1
	MOV	R3,R4			; shift by zero: value unchanged
	RT
_ccusr1:
	MOV	R3,R1
	SRL	R1,R0
	MOV	R1,R4
	RT

_ccasl::
    MOV R4,R0
    JNE _ccasl1
    MOV R3,R4
    RT

_ccasl1:
    MOV R3,R1
    SLA R1,R0
    MOV R1,R4
    RT
;
;Form the two's complement of R4 - converted to inline
;_ccneg::
;	NEG	R4
;	RT
	
;
;
; MULTIPYL R3 BY R4 AND RETURN IN R4 (SIGNED MULTIPLY)
;
_ccmult::
	CLR	R5
	MOV	R4,R1
	JGT	$+6
	NEG	R3
	INC 	R5
	MOV	R1,R1
	JGT	$+6
	NEG	R1
	INC	R5
	MPY	R1,R3
	MOV	R4,R1
	ANDI	R5,1
	JEQ	$+4
	NEG	R1
	MOV	R1,R4
	MOV	R2,R3
	RT	
;
; DIVIDE R3 BY R4 AND RETURN QUOTIENT IN HL, AND
; REMAINDER IN R3 (SIGNED DIVIDE)
;
_ccdiv::
	CLR 	R5
	MOV 	R4,R1
	MOV 	R3,R4
	JGT 	$+6
	NEG 	R4
	INC 	R5
	CLR 	R3
	MOV 	R1,R1
	JGT 	$+6
	NEG 	R1
	INC 	R5
	DIV 	R1,R3
	MOV 	R3,R1
	MOV 	R4,R2
	ANDI 	R5,1
	JEQ	$+6
	NEG	R1
	NEG	R2
	MOV	R1,R4
	MOV	R2,R3
	RT	
;
;
; LOGICAL NEGATION
;
_cclneg::
	MOV 	R4,R1
	JNE	$+6
	INC	R4		;R4 := 1
	RT
	CLR	R4
	RT
;
;------SIGN EXTEND------
;
_ccsxt::
	SETO	R0
	CLR	R1
	MOVB	R4,R1
	JGT	_ccsxt0
	MOVB	R4,R0
	MOV	R0,R1
_ccsxt0: 	SWPB	R1
	MOV	R1,R4
	RT
;
;
;--------------------------------------------------------------
;
; EXECUTE "SWITCH" STATEMENT
;
;  R4   =	SWITCH VALUE
; (SP)  ->	SWITCH TABLE - IE RETURN ADDRESS FROM CALL
;  DW   =	ADDR1, VALUE1
;  DW   =	ADDR2, VALUE2
;  ....
;
;  DW	   0
; [JMP	default ]
;  continuation 
;
;  NOTE.  YOU CANNOT USE MOV *SP+,R3 TO ACCESS THE ADDRESS AND THE XOP STACK IS IN SEGEMENT 0 THUS CODE
;         RUNNING IN OTHER SEGMENTS DO NOT HAVE ACCESS TO THE XOP SEGMENT 0 STACK.  CODE RUNNING IN SEG 0
;         CANNOT UPSE THE STACK BECAUSE SEG 1'S STACK POINTER IS THE AUTHORITY
;------------------------------------------------------------------------------------------------------
;

_ccswitc::	POP	R3		;; GET RETURN ADDRESS - SEE NOTE ABOVE
	MOV	*R3+,R1		;; R1 -> CASE ADDR, ELSE 0
	JEQ	SWEND		;; DEFAULT OR CONTINUATION CODE
	C	*R3+,R4		;; COMPARE AGAINST TABLE
	JNE	_ccswitc+2		;; NO MATCH
	MOV	R1,R3		;; CASE MATCH

SWEND	B	*R3		;; GO TO CODE
	END


